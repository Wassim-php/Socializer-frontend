<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.controllers.PostCreationController"
            prefWidth="600"
            prefHeight="700"
            style="-fx-background-color: #121212;">

    <!-- Top Bar -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #1E1E1E; -fx-padding: 15; -fx-alignment: center;">
            <Button text="← Back"
                    style="-fx-background-color: transparent; -fx-text-fill: #BB86FC; -fx-font-weight: bold;"
                    onAction="#handleGoBack" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Create New Post"
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 22;" />
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #121212; -fx-border-color: #121212;">
            <content>
                <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 20;">

                    <!-- Content Section -->
                    <VBox spacing="10" style="-fx-background-color: #1E1E1E; -fx-background-radius: 12; -fx-padding: 20;">
                        <Label text="What's on your mind?"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />
                        <TextArea fx:id="contentTextArea"
                                  promptText="Share your thoughts..."
                                  prefHeight="150"
                                  style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-border-color: #333333; -fx-border-radius: 8; -fx-control-inner-background: #2D2D2D;" />
                    </VBox>

                    <!-- Image Section -->
                    <VBox spacing="10" style="-fx-background-color: #1E1E1E; -fx-background-radius: 12; -fx-padding: 20;">
                        <Label text="Add an Image (Optional)"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />

                        <!-- Image Display -->
                        <ImageView fx:id="postImageView"
                                   fitWidth="300"
                                   fitHeight="300"
                                   style="-fx-border-color: #333333; -fx-border-radius: 8;"
                                   preserveRatio="true" />

                        <!-- Image Controls -->
                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="chooseImageButton"
                                    text="Choose Image"
                                    onAction="#handleChooseImage"
                                    style="-fx-background-color: #BB86FC; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 16; -fx-font-weight: bold;" />

                            <Button fx:id="removeImageButton"
                                    text="Remove Image"
                                    onAction="#handleRemoveImage"
                                    disable="true"
                                    style="-fx-background-color: #CF6679; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 16; -fx-font-weight: bold;" />
                        </HBox>

                        <Label fx:id="filenameLabel"
                               text="No image selected"
                               style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;" />
                    </VBox>

                    <!-- Action Buttons -->
                    <HBox spacing="20" alignment="CENTER">
                        <Button fx:id="cancelButton"
                                text="Cancel"
                                onAction="#handleCancel"
                                style="-fx-background-color: transparent; -fx-text-fill: #BB86FC; -fx-font-weight: bold; -fx-border-color: #BB86FC; -fx-border-radius: 10; -fx-padding: 10 20;" />

                        <Button fx:id="createButton"
                                text="Create Post"
                                onAction="#handleCreatePost"
                                style="-fx-background-color: #BB86FC; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-weight: bold;" />
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>