<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controllers.EditProfileController"
            prefWidth="500"
            prefHeight="600"
            style="-fx-background-color: #121212;">

    <top>
        <HBox spacing="10" style="-fx-background-color: #1E1E1E; -fx-padding: 15; -fx-alignment: center;">
            <Button text="← Back"
                    style="-fx-background-color: transparent; -fx-text-fill: #BB86FC; -fx-font-weight: bold;"
                    onAction="#handleCancel" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Edit Profile"
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 22;" />
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #121212; -fx-border-color: #121212;">
            <content>
                <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 20;">

                    <VBox spacing="15" style="-fx-background-color: #1E1E1E; -fx-background-radius: 12; -fx-padding: 20;">
                        <Label text="Edit Account Information"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 10 0;" />

                        <VBox spacing="5">
                            <Label text="Username" style="-fx-text-fill: white; -fx-font-size: 14;" />
                            <TextField fx:id="usernameField"
                                       promptText="Enter new username"
                                       style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 8; -fx-padding: 10;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Avatar Color" style="-fx-text-fill: white; -fx-font-size: 14;" />
                            <ColorPicker fx:id="avatarColorPicker"
                                         style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 8; -fx-padding: 4 6;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Current Password (required for password change)"
                                   style="-fx-text-fill: white; -fx-font-size: 14;" />
                            <PasswordField fx:id="currentPasswordField"
                                           promptText="Enter current password"
                                           style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 8; -fx-padding: 10;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label text="New Password (leave empty to keep current)"
                                   style="-fx-text-fill: white; -fx-font-size: 14;" />
                            <PasswordField fx:id="newPasswordField"
                                           promptText="Enter new password"
                                           style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 8; -fx-padding: 10;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Confirm New Password" style="-fx-text-fill: white; -fx-font-size: 14;" />
                            <PasswordField fx:id="confirmPasswordField"
                                           promptText="Confirm new password"
                                           style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 8; -fx-padding: 10;" />
                        </VBox>

                        <Label fx:id="errorLabel"
                               style="-fx-font-size: 14; -fx-wrap-text: true; -fx-padding: 10 0 0 0;"
                               prefHeight="50" />
                    </VBox>

                    <HBox spacing="20" alignment="CENTER">
                        <Button fx:id="cancelButton"
                                text="Cancel"
                                onAction="#handleCancel"
                                style="-fx-background-color: transparent; -fx-text-fill: #BB86FC; -fx-font-weight: bold; -fx-border-color: #BB86FC; -fx-border-radius: 10; -fx-padding: 10 20;" />

                        <Button fx:id="saveButton"
                                text="Save Changes"
                                onAction="#handleSave"
                                style="-fx-background-color: #BB86FC; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-weight: bold;" />
                    </HBox>

                    <VBox spacing="5" style="-fx-background-color: #1E1E1E; -fx-background-radius: 8; -fx-padding: 15;">
                        <Label text="⚠️ Note:" style="-fx-text-fill: #FFB74D; -fx-font-weight: bold;" />
                        <Label text="• Leave password fields empty if you only want to change username or avatar color"
                               style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" />
                        <Label text="• Current password is required to change password"
                               style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" />
                        <Label text="• New password must be at least 6 characters"
                               style="-fx-text-fill: #AAAAAA; -fx-font-size: 12;" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>