<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo.controllers.ProfileController"
      spacing="20"
      prefHeight="700"
      prefWidth="500"
      alignment="TOP_CENTER"
      style="-fx-background-color: #121212; -fx-padding: 20;">

    <!-- Header with Back Button and Create Post -->
    <HBox spacing="15" alignment="CENTER_LEFT" prefWidth="500">
        <Button text="← Back"
                onAction="#handleGoBack"
                style="-fx-background-color: transparent; -fx-text-fill: #BB86FC; -fx-font-weight: bold; -fx-border-color: #BB86FC; -fx-border-radius: 5; -fx-padding: 5 10;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="My Profile"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Create Post"
                onAction="#handleCreatePost"
                style="-fx-background-color: #BB86FC; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 16; -fx-font-weight: bold;" />
    </HBox>

    <!-- User Info Section -->
    <HBox spacing="15" alignment="CENTER_LEFT"
          style="-fx-background-color: #1E1E1E; -fx-background-radius: 12; -fx-padding: 20;">
        <Circle radius="30"
                style="-fx-fill: #BB86FC; -fx-stroke: #3700B3; -fx-stroke-width: 2;"
                onMouseClicked="#handleOpenAvatar" />
        <VBox spacing="5">
            <Label fx:id="usernameLabel" text="Loading..."
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <!-- Follow stats -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label fx:id="followersCountLabel" text="0 followers"
                       style="-fx-font-size: 12px; -fx-text-fill: #AAAAAA;" />
                <Label fx:id="followingCountLabel" text="0 following"
                       style="-fx-font-size: 12px; -fx-text-fill: #AAAAAA;" />
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Edit Profile"
                style="-fx-background-color: #BB86FC; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 16; -fx-font-weight: bold;"
                onAction="#handleEditProfile" />
    </HBox>

    <!-- Stats Bar -->
    <HBox spacing="30" alignment="CENTER"
          style="-fx-background-color: #1E1E1E; -fx-background-radius: 12; -fx-padding: 15;">
        <VBox alignment="CENTER" spacing="5">
            <Label text="Posts" style="-fx-font-size: 12px; -fx-text-fill: #AAAAAA;" />
            <Label fx:id="postCountLabel" text="0"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </VBox>

    </HBox>

    <!-- Follow Section -->
    <VBox spacing="10" prefWidth="500">
        <Label text="Follows" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-alignment: center-left;" />

        <HBox spacing="20" alignment="CENTER_LEFT" prefWidth="500">
            <Button fx:id="showFollowersBtn" text="Followers"
                    onAction="#handleShowFollowers"
                    style="-fx-background-color: #BB86FC; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 16; -fx-font-weight: bold;" />
            <Button fx:id="showFollowingBtn" text="Following"
                    onAction="#handleShowFollowing"
                    style="-fx-background-color: transparent; -fx-text-fill: #BB86FC; -fx-border-color: #BB86FC; -fx-border-radius: 10; -fx-padding: 8 16; -fx-font-weight: bold;" />
        </HBox>

        <!-- Users List - Make sure it has proper constraints -->
        <ListView fx:id="usersListView"
                  prefHeight="200"
                  minHeight="150"
                  maxHeight="300"
                  style="-fx-background-color: #1E1E1E;
                         -fx-border-color: #333;
                         -fx-border-radius: 8;
                         -fx-control-inner-background: #1E1E1E;
                         -fx-background-insets: 0;
                         -fx-padding: 0;">
            <!-- Remove default cell styling -->
        </ListView>
    </VBox>

    <!-- Posts Grid Section -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Your Posts"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-alignment: center-left;" />

        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #121212; -fx-border-color: #121212;"
                    VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="gridPane"
                          hgap="10"
                          vgap="10"
                          alignment="TOP_CENTER"
                          prefWrapLength="440"
                          style="-fx-background-color: #121212;" />
            </content>
        </ScrollPane>
    </VBox>

</VBox>