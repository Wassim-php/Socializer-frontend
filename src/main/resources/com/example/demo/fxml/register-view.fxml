<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="25" alignment="CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo.controllers.RegisterController"
      styleClass="root"
      prefWidth="400" prefHeight="500">

    <Label text="Create Account"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #BB86FC;" />

    <VBox spacing="15" alignment="CENTER" style="-fx-background-color: #1E1E1E; -fx-padding: 40; -fx-background-radius: 16;">
        <GridPane hgap="10" vgap="15">
            <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="usernameField" promptText="Enter username" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <PasswordField fx:id="passwordField" promptText="Enter password" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        </GridPane>

        <Button text="Register"
                onAction="#handleRegister"
                styleClass="button" />

        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?" />
            <Hyperlink text="Login" onAction="#openLogin" />
        </HBox>
    </VBox>

    <Label fx:id="statusLabel" text="" />
</VBox>
