<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo.controllers.PostController"
      alignment="TOP_CENTER"
      style="-fx-background-color: #121212; -fx-padding: 20;">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="⬅ Back"
                onAction="#goBack"
                style="-fx-background-color: transparent; -fx-text-fill: #BB86FC; -fx-font-weight: bold;" />
        <Label fx:id="userLabel"
               style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: white;" />
    </HBox>

    <ImageView fx:id="postImageView"
               fitWidth="320" fitHeight="220"
               preserveRatio="true"
               style="-fx-effect: dropshadow(gaussian, black, 20, 0.2, 0, 4); -fx-background-radius: 10;" />

    <Label fx:id="captionLabel"
           wrapText="true"
           style="-fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 0;" />

    <Label text="Comments:"
           style="-fx-font-weight: bold; -fx-text-fill: #BB86FC; -fx-font-size: 14;" />

    <ListView fx:id="commentList"
              prefHeight="280"
              VBox.vgrow="ALWAYS"
              style="-fx-control-inner-background: #1E1E1E; -fx-text-fill: white; -fx-background-radius: 8;" />

    <HBox spacing="10" style="-fx-padding: 5;">
        <TextField fx:id="commentField"
                   promptText="Write a comment..."
                   HBox.hgrow="ALWAYS"
                   style="-fx-background-color: #2A2A2A; -fx-text-fill: white; -fx-background-radius: 20; -fx-prompt-text-fill: #888; -fx-padding: 8 12;" />
        <Button fx:id="addCommentButton"
                text="Post"
                onAction="#addComment"
                style="-fx-background-color: #BB86FC; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold; -fx-padding: 8 16;" />
    </HBox>
</VBox>
